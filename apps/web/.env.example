# Public, non-secret config only. Never put service keys here (core principle 5).
VITE_API_BASE=http://127.0.0.1:8787
# supabase (default) | mock (local: services/core/cmd/mockauth)
VITE_AUTH_MODE=mock
VITE_MOCK_AUTH_URL=http://127.0.0.1:8095
# Production only: the project's public anon key (never the service-role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
